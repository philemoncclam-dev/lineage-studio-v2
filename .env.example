# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Microsoft Purview -------------------------------------------------
# Short account name only (no scheme, no .purview.azure.com suffix).
PURVIEW_ACCOUNT_NAME=Phil-purview-dev

# Service principal. Needs Data Reader on the collection to read lineage,
# and Data Curator to push it (see PURVIEW_ALLOW_WRITE below).
PURVIEW_TENANT_ID=
PURVIEW_CLIENT_ID=
PURVIEW_CLIENT_SECRET=

# Write guard. Reads always work; writes are refused unless this is true.
# Leave false until you've confirmed the read path against your instance.
PURVIEW_ALLOW_WRITE=false

# Unified Catalog (data products) uses a role model of its own, separate from
# data-map collection roles: the service principal needs Data Product Owner on
# a governance domain, or reads return 200 and writes return 403.

# --- The assistant ------------------------------------------------------
# Absent is a normal state: /chat/status reports it and the UI hides the
# assistant rather than offering a button that always fails.
ANTHROPIC_API_KEY=

# Refuse a question from a caller who sent no bearer token. ON by default,
# because /chat/ask is the only route that spends money — an open one on a
# public URL is a billing account anyone with the address can draw on.
# Set false only on a local backend where sign-in isn't configured.
CHAT_REQUIRE_AUTH=true

# --- Frontend origins ---------------------------------------------------
# Comma-separated browser origins allowed to call this API, for a deployed
# frontend. The Vite dev server (localhost:5173) is always allowed.
# This API can spend the credentials above, so keep it to origins you control.
CORS_ORIGINS=

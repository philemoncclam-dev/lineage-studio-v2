# Python
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/

# Node
node_modules/
frontend/dist/
*.local

# Secrets — never commit. .env.example is the tracked template.
# The .txt/.bak variants matter: Windows editors silently append an extension,
# and a bare `*.env` rule would not match `.env.txt`.
.env
*.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
backend/data/

# Pinned Spark venv for the notebook sandbox (M2b) — machine-local
/sandbox/.venv312/

# Local-only design reference material. Never published.
/Inspo/

# Eval transcripts — a paid run's output, per-machine and not worth versioning.
backend/*.json

# The local share store (backend/app/share). Real deployments set DATABASE_URL.
*.db

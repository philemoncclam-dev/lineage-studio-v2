# Base URL of the Lineage Studio backend.
# Local development needs nothing here — the default is http://localhost:8000.
# Set this in Vercel (Project → Settings → Environment Variables) to the public
# URL of a deployed backend. Vite inlines it at BUILD time, so changing it
# requires a redeploy, not just a restart.
VITE_API_BASE=https://your-backend.example.com

# ── Fabric connector (Modelling tab → Import → Fabric) ─────────────────────
# Copy this file to `.env` (gitignored) and fill in the two values below to
# enable real "Sign in with Microsoft" against your tenant. Until CLIENT_ID is
# set, the Fabric connector only offers the manual bearer-token fallback.
#
# VITE_FABRIC_CLIENT_ID — the *Application (client) ID* of an Entra SPA app
#   registration. The registration must:
#     • have platform type "Single-page application"
#     • register this app's origin as a redirect URI (dev:
#       http://localhost:5173  — and whatever Vercel URL you deploy to)
#     • expose delegated Microsoft Fabric permissions: Workspace.Read.All,
#       Item.Read.All (Tenant.Read.All only if you use the admin deep-scan)
VITE_FABRIC_CLIENT_ID=

# VITE_FABRIC_TENANT_ID — Entra tenant id, or one of "organizations" (default),
#   "common", "consumers". "organizations" accepts any work/school account.
VITE_FABRIC_TENANT_ID=organizations

# VITE_FABRIC_MOCK — set to 1 to run the connector against built-in fixtures
#   with no Azure setup (offline demo). Leave unset for real sign-in.
# VITE_FABRIC_MOCK=1

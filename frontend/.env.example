# Base URL of the Lineage Studio backend.
# Local development needs nothing here — the default is http://localhost:8000.
# Set this in Vercel (Project → Settings → Environment Variables) to the public
# URL of a deployed backend. Vite inlines it at BUILD time, so changing it
# requires a redeploy, not just a restart.
VITE_API_BASE=https://your-backend.example.com

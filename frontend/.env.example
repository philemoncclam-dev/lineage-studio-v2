# Entra ID sign-in (frontend/src/auth/msal.ts).
#
# Without VITE_ENTRA_CLIENT_ID the app still runs: the sign-in screen explains
# what to register and offers to continue on the backend's service principal —
# which means the workspaces in Explore are that shared account's, not yours.
#
# Register a SINGLE-PAGE APPLICATION in Entra ID, add http://localhost:5173 as
# a redirect URI, and grant the delegated permission
# `Fabric -> user_impersonation` (then consent).
VITE_ENTRA_CLIENT_ID=

# A tenant GUID pins sign-in to one directory. `organizations` (the default)
# admits any work or school account, which is what you want while developing
# against somebody else's tenant.
VITE_ENTRA_TENANT_ID=organizations

# Where the FastAPI backend lives. Defaults to http://localhost:8000.
VITE_API_BASE=
